# Local development configuration
# For deployment, these are set via Terraform / the deploy command.

# Vertex AI Configuration (default)
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global

# Alternatively, for Gemini API via Google AI Studio,
# comment out the three lines above and uncomment:
# GEMINI_API_KEY=your-api-key-here

# GITHUB_TOKEN_FILE=~/.config/issue-to-pr/github-token  (a path; the token itself never goes in .env)

# Live mode (python -m app.live)
# Comma-separated owner/name repositories live runs may work on; unset or empty turns live mode off.
# LIVE_REPOS=owner/name
# Comma-separated logins that may author a live issue and add its agent-ok label; unset or empty refuses every issue.
# LIVE_ALLOWED_USERS=your-login
# Seconds the driver waits for the approver before it rejects (default 3600).
# APPROVAL_TIMEOUT_S=3600
# Seconds one Gemini call may stay silent before it is sent again once, then fails as infra (default 480; must stay below RUN_TIMEOUT_S).
# MODEL_CALL_TIMEOUT_S=480
