@@ -0,0 +1,28 @@
+"""Image alt text is escaped once, like the rest of the output."""
+
+from mdlite import to_html
+
+
+def test_ampersand_in_alt_text_is_escaped_once():
+    assert to_html("![Tom & Jerry](/img/tj.png)") == (
+        '<p><img src="/img/tj.png" alt="Tom &amp; Jerry"></p>\n'
+    )
+
+
+def test_angle_brackets_in_alt_text_are_escaped_once():
+    assert to_html("![a < b](/img/cmp.png)") == (
+        '<p><img src="/img/cmp.png" alt="a &lt; b"></p>\n'
+    )
+    assert to_html("![a > b](/img/cmp.png)") == (
+        '<p><img src="/img/cmp.png" alt="a &gt; b"></p>\n'
+    )
+
+
+def test_alt_text_with_emphasis_keeps_only_the_text():
+    assert to_html("![*Fish* & chips](/img/f.png)") == (
+        '<p><img src="/img/f.png" alt="Fish &amp; chips"></p>\n'
+    )
+
+
+def test_refused_image_url_still_shows_the_alt_text_escaped_once():
+    assert to_html("![Tom & Jerry](javascript:alert(1))") == "<p>Tom &amp; Jerry</p>\n"
