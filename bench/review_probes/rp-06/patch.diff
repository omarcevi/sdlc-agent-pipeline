+    def import_stocktake(self, path: str | Path) -> tuple[csvio.RowError, ...]:
+        """Set on-hand counts from a stocktake CSV file (`sku,counted`).
+
+        Each count that differs from the units on hand is recorded as one
+        adjustment with the reason `stocktake`; products not in the file are
+        left alone. A bad row is skipped and returned, in file order."""
+        errors: list[csvio.RowError] = []
+        for line, row in csvio.read_stocktake(path):
+            try:
+                fields = csvio.row_fields(row)
+                counted = csvio.parse_count(fields["counted"])
+                sku = fields["sku"]
+                delta = counted - self.inventory.on_hand(sku)
+                if delta:
+                    self.inventory.adjust(sku, delta, STOCKTAKE_REASON)
+            except StockroomError as exc:
+                errors.append(csvio.RowError(line, str(exc)))
+        return tuple(errors)
