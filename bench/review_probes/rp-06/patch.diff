@@ -0,0 +1,71 @@
+from decimal import Decimal
+
+import pytest
+from stockroom import Product, Store, Unit
+from stockroom.errors import CsvFormatError
+
+
+def make_store():
+    store = Store(tax_percent="0")
+    store.add_product(Product("PEN-1", "Pen", Unit.EACH, Decimal("1.50")))
+    store.add_product(Product("BOOK-1", "Notebook", Unit.EACH, Decimal("4.99")))
+    store.receive("PEN-1", 100)
+    store.receive("BOOK-1", 20)
+    return store
+
+
+def write(tmp_path, text):
+    path = tmp_path / "stocktake.csv"
+    path.write_text(text, encoding="utf-8")
+    return path
+
+
+def stocktake_entries(store):
+    return [
+        (entry.sku, entry.quantity)
+        for entry in store.ledger.entries()
+        if entry.reason == "stocktake"
+    ]
+
+
+def test_issue_example_sets_the_counted_units(tmp_path):
+    store = make_store()
+    errors = store.import_stocktake(
+        write(tmp_path, "sku,counted\nPEN-1,97\nBOOK-1,24\n")
+    )
+    assert errors == ()
+    assert store.stock("PEN-1").on_hand == 97
+    assert store.stock("BOOK-1").on_hand == 24
+    assert sorted(stocktake_entries(store)) == [("BOOK-1", 4), ("PEN-1", -3)]
+
+
+def test_matching_count_records_nothing(tmp_path):
+    store = make_store()
+    errors = store.import_stocktake(write(tmp_path, "counted,sku\n100,pen-1\n"))
+    assert errors == ()
+    assert stocktake_entries(store) == []
+
+
+def test_unknown_sku_and_bad_count_are_reported_with_their_lines(tmp_path):
+    store = make_store()
+    errors = store.import_stocktake(
+        write(tmp_path, "sku,counted\nNOPE-1,4\nPEN-1,98\nBOOK-1,lots\n")
+    )
+    assert [error.line for error in errors] == [2, 4]
+    assert store.stock("PEN-1").on_hand == 98
+    assert store.stock("BOOK-1").on_hand == 20
+
+
+def test_stocktake_cannot_go_below_reserved_units(tmp_path):
+    store = make_store()
+    store.reserve_order(store.create_order([("PEN-1", 30)]).id)
+    errors = store.import_stocktake(write(tmp_path, "sku,counted\nPEN-1,25\n"))
+    assert [error.line for error in errors] == [2]
+    assert store.stock("PEN-1").on_hand == 100
+
+
+def test_file_with_other_columns_is_refused(tmp_path):
+    store = make_store()
+    with pytest.raises(CsvFormatError):
+        store.import_stocktake(write(tmp_path, "sku,counted,shelf\nPEN-1,97,A3\n"))
+    assert store.stock("PEN-1").on_hand == 100
