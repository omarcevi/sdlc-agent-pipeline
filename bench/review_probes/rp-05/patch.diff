diff --git a/tests/test_explicit_heading_ids.py b/tests/test_explicit_heading_ids.py
new file mode 100644
index 0000000..244eabd
--- /dev/null
+++ b/tests/test_explicit_heading_ids.py
@@ -0,0 +1,44 @@
+"""Headings can set their own id with a trailing `{#id}`."""
+
+import pytest
+from mdlite import to_html, toc
+
+
+def test_install_heading_from_the_issue():
+    assert to_html("## Installing on Linux {#install}") == (
+        '<h2 id="install">Installing on Linux</h2>\n'
+    )
+
+
+def test_explicit_id_keeps_its_case_and_shows_in_toc():
+    text = "# Release Notes {#Release_Notes-v2}\n\n## Changes"
+    assert to_html(text) == (
+        '<h1 id="Release_Notes-v2">Release Notes</h1>\n<h2 id="changes">Changes</h2>\n'
+    )
+    assert toc(text) == [
+        (1, "Release Notes", "Release_Notes-v2"),
+        (2, "Changes", "changes"),
+    ]
+
+
+def test_tab_before_the_id_works_like_a_space():
+    assert to_html("### API\t{#api-ref}") == '<h3 id="api-ref">API</h3>\n'
+
+
+@pytest.mark.parametrize(
+    ("source", "html"),
+    [
+        ("## Setup{#setup}", '<h2 id="setupsetup">Setup{#setup}</h2>\n'),
+        (
+            "## Setup {#setup} later",
+            '<h2 id="setup-setup-later">Setup {#setup} later</h2>\n',
+        ),
+        ("## Setup {#set.up}", '<h2 id="setup-setup">Setup {#set.up}</h2>\n'),
+    ],
+)
+def test_braces_that_do_not_match_exactly_are_text(source, html):
+    assert to_html(source) == html
+
+
+def test_paragraphs_keep_the_braces():
+    assert to_html("See {#intro} below.") == "<p>See {#intro} below.</p>\n"
