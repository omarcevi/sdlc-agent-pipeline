@@ -0,0 +1,30 @@
+"""Tests for image alt text escaping."""
+
+from mdlite import to_html
+
+
+def test_image_alt_text_is_escaped_once():
+    assert to_html("![Tom & Jerry](/img/tj.png)") == (
+        '<p><img src="/img/tj.png" alt="Tom &amp; Jerry"></p>\n'
+    )
+    assert to_html("![a < b](/img/cmp.png)") == (
+        '<p><img src="/img/cmp.png" alt="a &lt; b"></p>\n'
+    )
+    assert to_html("![a > b](/img/cmp.png)") == (
+        '<p><img src="/img/cmp.png" alt="a &gt; b"></p>\n'
+    )
+
+
+def test_image_alt_text_quotes_escaped():
+    assert to_html('![Tom "the cat" & \'Jerry\'](/img/tj.png)') == (
+        '<p><img src="/img/tj.png" alt="Tom &quot;the cat&quot; &amp; &#39;Jerry&#39;"></p>\n'
+    )
+
+
+def test_unsafe_image_url_falls_back_to_escaped_alt_text():
+    assert to_html("![Tom & Jerry](javascript:alert(1))") == (
+        "<p>Tom &amp; Jerry</p>\n"
+    )
+    assert to_html("![a < b](javascript:alert(1))") == (
+        "<p>a &lt; b</p>\n"
+    )
