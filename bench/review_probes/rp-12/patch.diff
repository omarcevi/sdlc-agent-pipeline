+    def resolve_items(
+        self, items: Iterable[tuple[str, int]]
+    ) -> list[tuple[Product, int]]:
+        """Turn (sku, quantity) pairs into (product, quantity) pairs.
+
+        Repeated SKUs are merged in order of first appearance with quantities
+        added up. Each product is the catalog's current entry for that SKU.
+        """
+        return [
+            (self.get(sku), quantity)
+            for sku, quantity in merge_items(items).items()
+        ]
